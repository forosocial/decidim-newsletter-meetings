<!--
insert_after 'div#participatory_spaces_for_select'
-->

<div class="card mb-2" id="meetings_for_select">
  <div class="card-divider">
    <h2 class="card-title"><%= t ".select_meeting" %></h2>
  </div>
  <div class="card-section">
    <div class="row column">
      <%= f.select :meeting_id,
            options_from_collection_for_select(
              meetings_for_newsletter_select, :id,
              ->(meeting) { "#{translated_attribute(meeting.title)} (#{l(meeting.start_time, format: :decidim_short)})" },
              @form.meeting_id
            ),
            prompt: t(".select_meeting_prompt") %>
    </div>
  </div>
</div>

<%= javascript_tag nonce: true do %>
  (function () {
    var checkbox = document.getElementById("newsletter_send_to_event_registrants");
    var selector = document.getElementById("meetings_for_select");
    var meeting_select = document.getElementById("newsletter_meeting_id");
    if (!checkbox || !selector) { return; }

    var toggle = function () {
      selector.style.display = checkbox.checked ? "" : "none";

      if (!checkbox.checked) {
          if (meeting_select.value !== "") {
            meeting_select.value = "";
            meeting_select.dispatchEvent(new Event("change", { bubbles: true }));
          }
      }
    };

    checkbox.addEventListener("change", toggle);
    toggle();
  })();
<% end %>
